# Passordene til databasen. Fungerer som de er til testing lokalt,
# men bytt dem til egne passord (minst 16 tegn) hvis appen skal brukes til noe annet.
DB_ROOT_PASSWORD=bytt_meg_root_passord_2026
DB_PASSWORD=bytt_meg_app_passord_2026
# Porten databasen får på din maskin. Bytt til f.eks. 3307 hvis 3306 er opptatt.
DB_PORT=3306
# Passordet til testbrukerne (test, privat og admin). Se docs/drift.md.
# Minst 8 tegn, med stor og liten bokstav og tall. Står også i README.
# Tomt = ingen testbrukere, og da finnes det ingen admin som kan godkjenne offentlige aktører.
TESTBRUKER_PASSORD=Beredt2026

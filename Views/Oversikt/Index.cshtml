@model OversiktViewModel
@{
    ViewData["Title"] = "Oversikt";

    // Offentlige aktører ser behov og tildelinger. Private aktører ser bare sine egne ressurser.
    var erOffentligAktor = User.IsInRole("OffentligAktor");

}

<div class="bp-side-innhold">

    @* Toppen av siden: tittel, forklaring og når siden sist ble hentet *@
    <div class="bp-oversikt-hode">
        <div>
            <h1>Oversikt</h1>
            <p>
                @(erOffentligAktor
                    ? "Det viktigste akkurat nå: behov, ressurser og det som krever handling."
                    : "Ressursene du har tilbudt, og om de er satt inn der det trengs.")
            </p>
        </div>
        @* Klokkeslettet fylles inn av skriptet nederst. Klikk for å hente siden på nytt. *@
        <a class="bp-oversikt-oppdatert" asp-controller="Oversikt" asp-action="Index">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 12a9 9 0 1 1-3-6.7L21 8" />
                <path d="M21 3v5h-5" />
            </svg>
            Oppdatert kl. <span id="oppdatert-tid"></span>
        </a>
    </div>

    @* Tre nøkkeltall. Hvert kort er en lenke til siden der man ser mer. *@
    @if (erOffentligAktor)
    {
        @* ---------- Offentlige aktører ---------- *@
        <div class="bp-nokkeltall">
            <a class="bp-nokkeltall-kort" asp-controller="Behov" asp-action="Index">
                <span class="bp-ikon-firkant bp-farge-behov" aria-hidden="true">
                    @* Kartnål = behov, som på kartet *@
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                        <circle cx="12" cy="10" r="3" />
                    </svg>
                </span>
                <span>
                    <span class="bp-nokkeltall-etikett">Behov som venter</span>
                    <span class="bp-nokkeltall-tall">@Model.AntallAktiveBehov</span>
                    <span class="bp-nokkeltall-detalj">
                        <span class="bp-prikk bp-prikk-hoy"></span>@Model.AntallHoy høy
                        <span class="bp-prikk bp-prikk-moderat"></span>@Model.AntallModerat moderat
                        <span class="bp-prikk bp-prikk-lav"></span>@Model.AntallLav lav
                    </span>
                </span>
            </a>

            <a class="bp-nokkeltall-kort" asp-controller="Kart" asp-action="Index">
                <span class="bp-ikon-firkant bp-farge-ressurs" aria-hidden="true">
                    @* Eske = ressurs *@
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 8 12 3 3 8v8l9 5 9-5Z" />
                        <path d="m3 8 9 5 9-5M12 13v8" />
                    </svg>
                </span>
                <span>
                    <span class="bp-nokkeltall-etikett">Tilgjengelige ressurser</span>
                    <span class="bp-nokkeltall-tall">@Model.AntallTilgjengeligeRessurser</span>
                    <span class="bp-nokkeltall-detalj">Ikke tildelt noe behov ennå</span>
                </span>
            </a>

            <a class="bp-nokkeltall-kort" asp-controller="Behov" asp-action="Index">
                <span class="bp-ikon-firkant bp-farge-ressurs" aria-hidden="true">
                    @* Hake = tildelt *@
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="9" />
                        <path d="m8 12.5 2.5 2.5L16 9.5" />
                    </svg>
                </span>
                <span>
                    <span class="bp-nokkeltall-etikett">Tildelte behov</span>
                    <span class="bp-nokkeltall-tall">@Model.AntallTildelteBehov</span>
                    <span class="bp-nokkeltall-detalj">Har fått minst én ressurs</span>
                </span>
            </a>
        </div>

        <div class="bp-oversikt-kolonner">

            @* Venstre: behov med høy prioritet som ingen har tatt tak i ennå *@
            <section class="bp-oversikt-panel">
                <div class="bp-oversikt-panel-hode">
                    <div>
                        <h2>
                            <svg class="bp-farge-behov" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z" />
                                <line x1="12" y1="9" x2="12" y2="13" />
                                <line x1="12" y1="17" x2="12.01" y2="17" />
                            </svg>
                            Krever oppmerksomhet
                        </h2>
                        <p>Behov med høy prioritet som venter på en ressurs.</p>
                    </div>
                    <a asp-controller="Behov" asp-action="Index">Se alle behov</a>
                </div>

                @if (Model.KreverOppmerksomhet.Count == 0)
                {
                    <p class="bp-oversikt-tom">Ingen behov med høy prioritet venter akkurat nå.</p>
                }
                else
                {
                    <ul class="bp-oversikt-liste">
                        @foreach (var behov in Model.KreverOppmerksomhet)
                        {
                            <li>
                                @* Samme ikon som på kartet. Fylles inn av skriptet nederst (kartikoner.js). *@
                                <span class="bp-kartikon bp-ikon-hoy" data-ikon-type="@behov.Type"></span>
                                <span class="bp-oversikt-liste-tekst">
                                    @* Navnet er en lenke til detaljsiden for behovet (Behov/Detaljer/id). *@
                                    <a class="bp-oversikt-lenke" asp-controller="Behov" asp-action="Detaljer" asp-route-id="@behov.Id">@behov.VisningsNavn</a>
                                    <span>@behov.GeografiskOmrade</span>
                                </span>
                                <span class="bp-badge bp-badge-hoy">Høy</span>
                                <span class="bp-oversikt-dato">@behov.Dato.ToString("dd.MM")</span>
                            </li>
                        }
                    </ul>
                }
            </section>

            @* Høyre: de sist meldte behovene som venter, uansett prioritet *@
            <section class="bp-oversikt-panel">
                <div class="bp-oversikt-panel-hode">
                    <div>
                        <h2>Siste meldte behov</h2>
                        <p>De fem nyeste behovene som venter på en ressurs.</p>
                    </div>
                </div>

                <ul class="bp-oversikt-liste">
                    @foreach (var behov in Model.SisteBehov)
                    {
                        var prioritetCss = PrioritetVisning.CssNavn(behov.Prioritet);
                        <li>
                            <span class="bp-kartikon bp-ikon-@prioritetCss" data-ikon-type="@behov.Type"></span>
                            <span class="bp-oversikt-liste-tekst">
                                @* Navnet er en lenke til detaljsiden for behovet (Behov/Detaljer/id). *@
                                    <a class="bp-oversikt-lenke" asp-controller="Behov" asp-action="Detaljer" asp-route-id="@behov.Id">@behov.VisningsNavn</a>
                                <span>@behov.GeografiskOmrade</span>
                            </span>
                            @* Høy og moderat prioritet får et merke. Lav står uten, så det ikke blir for mange farger. *@
                            @if (behov.Prioritet != Prioritet.Lav)
                            {
                                <span class="bp-badge bp-badge-@prioritetCss">@PrioritetVisning.Tekst(behov.Prioritet)</span>
                            }
                            <span class="bp-oversikt-dato">@behov.Dato.ToString("dd.MM")</span>
                        </li>
                    }
                </ul>
            </section>
        </div>


        @* Tildelte ressurser: hvert behov som har fått ressurser, og hvilke ressurser det er. *@
        <section class="bp-oversikt-panel bp-oversikt-blokk">
            <div class="bp-oversikt-panel-hode">
                <div>
                    <h2>Tildelte ressurser</h2>
                    <p>Behov som har fått ressurser, og hvilke ressurser som er satt inn.</p>
                </div>
            </div>

            @if (Model.TildelteBehov.Count == 0)
            {
                <p class="bp-oversikt-tom">Ingen ressurser er tildelt ennå.</p>
            }
            else
            {
                <ul class="bp-oversikt-liste">
                    @foreach (var rad in Model.TildelteBehov)
                    {
                        <li class="bp-tildeling">
                            @* Behovet til venstre *@
                            <span class="bp-kartikon bp-ikon-@PrioritetVisning.CssNavn(rad.Behov.Prioritet)" data-ikon-type="@rad.Behov.Type"></span>
                            <span class="bp-oversikt-liste-tekst">
                                <a class="bp-oversikt-lenke" asp-controller="Behov" asp-action="Detaljer" asp-route-id="@rad.Behov.Id">@rad.Behov.VisningsNavn</a>
                                <span>@rad.Behov.GeografiskOmrade</span>
                            </span>

                            @* Ressursene til høyre, med samme ikon som på kartet *@
                            <ul class="bp-tildeling-ressurser">
                                @foreach (var ressurs in rad.Ressurser)
                                {
                                    <li>
                                        <span class="bp-kartikon bp-ikon-ressurs" data-ikon-type="@ressurs.Type" data-ikon-form="ressurs"></span>
                                        <span class="bp-oversikt-liste-tekst">
                                            <strong>@ressurs.Type</strong>
                                            <span>@ressurs.Adresse</span>
                                        </span>
                                    </li>
                                }
                            </ul>
                        </li>
                    }
                </ul>
            }
        </section>

        @* Snarveier til det man oftest skal gjøre. «Registrer nytt behov» er fremhevet i oransje. *@
        <section class="bp-oversikt-panel">
            <div class="bp-oversikt-panel-hode">
                <div>
                    <h2>Snarveier</h2>
                    <p>Gå direkte til det du trenger.</p>
                </div>
            </div>

            <div class="bp-snarveier">
                <a class="bp-snarvei" asp-controller="Kart" asp-action="Index">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M1 6v16l7-4 8 4 7-4V2l-7 4-8-4-7 4Z" /><line x1="8" y1="2" x2="8" y2="18" /><line x1="16" y1="6" x2="16" y2="22" />
                    </svg>
                    <span><strong>Åpne kart</strong><span>Se behov og ressurser</span></span>
                </a>
                <a class="bp-snarvei" asp-controller="Behov" asp-action="Index">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                        <line x1="8" y1="6" x2="21" y2="6" /><line x1="8" y1="12" x2="21" y2="12" /><line x1="8" y1="18" x2="21" y2="18" />
                        <line x1="3" y1="6" x2="3.01" y2="6" /><line x1="3" y1="12" x2="3.01" y2="12" /><line x1="3" y1="18" x2="3.01" y2="18" />
                    </svg>
                    <span><strong>Alle behov</strong><span>Liste over alt som er meldt inn</span></span>
                </a>
                <a class="bp-snarvei" asp-controller="Ressurs" asp-action="Registrer">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M21 8 12 3 3 8v8l9 5 9-5Z" /><path d="m3 8 9 5 9-5M12 13v8" />
                    </svg>
                    <span><strong>Tilby ressurs</strong><span>Registrer utstyr eller kjøretøy</span></span>
                </a>
                <a class="bp-snarvei bp-snarvei-fremhevet" asp-controller="Behov" asp-action="Registrer">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                        <line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" />
                    </svg>
                    <span><strong>Registrer nytt behov</strong><span>Meld inn hva som trengs</span></span>
                </a>
            </div>
        </section>
    }
    else
    {
        @* ---------- Private aktører ---------- *@
        @* Private aktører ser bare sine egne ressurser. De får vite om en ressurs er
           tildelt et behov, men ikke hvilket behov det er. *@
        var antallMine = Model.MineRessurser.Count;
        var antallTildelt = Model.MineRessurser.Count(r => r.ErTildelt);

        <div class="bp-nokkeltall bp-nokkeltall-to">
            <div class="bp-nokkeltall-kort">
                <span class="bp-ikon-firkant bp-farge-ressurs" aria-hidden="true">
                    @* Eske = ressurs *@
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 8 12 3 3 8v8l9 5 9-5Z" />
                        <path d="m3 8 9 5 9-5M12 13v8" />
                    </svg>
                </span>
                <span>
                    <span class="bp-nokkeltall-etikett">Dine ressurser</span>
                    <span class="bp-nokkeltall-tall">@antallMine</span>
                    <span class="bp-nokkeltall-detalj">Registrert av deg</span>
                </span>
            </div>
            <div class="bp-nokkeltall-kort">
                <span class="bp-ikon-firkant bp-farge-ressurs" aria-hidden="true">
                    @* Hake = tildelt *@
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="9" />
                        <path d="m8 12.5 2.5 2.5L16 9.5" />
                    </svg>
                </span>
                <span>
                    <span class="bp-nokkeltall-etikett">Tildelt</span>
                    <span class="bp-nokkeltall-tall">@antallTildelt</span>
                    <span class="bp-nokkeltall-detalj">Satt inn der det trengs</span>
                </span>
            </div>
        </div>

        <section class="bp-oversikt-panel bp-oversikt-blokk">
            <div class="bp-oversikt-panel-hode">
                <div>
                    <h2>Dine ressurser</h2>
                    <p>Ressursene du har tilbudt, og om de er tildelt et behov.</p>
                </div>
                <a class="btn btn-bp-primær" asp-controller="Ressurs" asp-action="Registrer">Tilby ressurs</a>
            </div>

            @if (antallMine == 0)
            {
                <p class="bp-oversikt-tom">Du har ikke tilbudt noen ressurser ennå. Trykk «Tilby ressurs» for å registrere den første.</p>
            }
            else
            {
                <ul class="bp-oversikt-liste">
                    @foreach (var rad in Model.MineRessurser)
                    {
                        <li>
                            <span class="bp-kartikon bp-ikon-ressurs" data-ikon-type="@rad.Ressurs.Type" data-ikon-form="ressurs"></span>
                            <span class="bp-oversikt-liste-tekst">
                                <strong>@rad.Ressurs.Type</strong>
                                <span>@rad.Ressurs.Adresse</span>
                            </span>
                            @if (rad.ErTildelt)
                            {
                                <span class="bp-badge bp-badge-tildelt">Tildelt et behov</span>
                            }
                            else
                            {
                                <span class="bp-badge bp-badge-venter">Tilgjengelig</span>
                            }
                        </li>
                    }
                </ul>
            }
        </section>
    }
</div>

@section Scripts {
    @* kartikoner.js har funksjonen lagIkonSvg, som lager de samme ikonene som på kartet. *@
    <script src="~/js/kartikoner.js" asp-append-version="true"></script>
    <script>
        // Setter inn kartikonet foran hvert behov og hver ressurs i listene.
        // Typen står i data-ikon-type. data-ikon-form="ressurs" gir firkant, ellers blir det nål (behov).
        document.querySelectorAll('[data-ikon-type]').forEach(function (element) {
            var form = element.dataset.ikonForm || 'behov';
            element.innerHTML = lagIkonSvg(form, element.dataset.ikonType, 32);
        });

        // Viser klokkeslettet siden ble hentet, i brukerens egen tid (f.eks. 14:32).
        document.getElementById('oppdatert-tid').textContent =
            new Date().toLocaleTimeString('no-NO', { hour: '2-digit', minute: '2-digit' });
    </script>
}

@{
    // Henter ut hvilken Controller/Action som vises akkurat nå, slik at vi kan
    // style riktig lenke som "aktiv" i menyen og vise ulik meny avhengig
    // av om noen er logget inn eller ikke.
    var gjeldendeController = ViewContext.RouteData.Values["controller"]?.ToString();
    var gjeldendeAction = ViewContext.RouteData.Values["action"]?.ToString();
    var erInnlogget = User.Identity?.IsAuthenticated ?? false;

    // Navn og rolle til innlogget bruker, vises i menyen.
    var brukerNavn = User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value;
    var rolleTekst = User.IsInRole("OffentligAktor") ? "Offentlig aktør" : "Privat aktør";

    bool ErAktiv(string controller) => string.Equals(gjeldendeController, controller, StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BeredskapsPortalen</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <script type="importmap"></script>
    @* Skrifttype: Outfit (Google Fonts) ligner den geometriske skriften Forsvaret bruker.
       Uten nett faller nettleseren tilbake til systemskriften (se site.css). *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@@300;400;500;600&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Beredskapsportal.styles.css" asp-append-version="true" />
    @* Lar enkeltsider legge til egne stilark, f.eks. kartsidene (Leaflet). *@
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @* =====================================================================
       Toppen: "Meny" til venstre, logo i midten, sidelenkene til høyre.
       "Meny" åpner en liten nedtrekksmeny med kontoting (Min side, Innstillinger,
       Språk, Logg ut). Bootstrap sin dropdown åpner/lukker den, så vi trenger
       ingen egen JavaScript: klikk utenfor eller Esc lukker den også.
       data-bs-display="static" gjør at plasseringen styres av site.css (.bp-meny).
       ===================================================================== *@
    <header class="bp-header">
        <div class="bp-header-innhold">
            <div class="dropdown bp-meny-omrade">
                <button type="button" class="bp-header-knapp" data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false">
                    <svg class="bp-meny-ikon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                        <line x1="4" y1="8" x2="20" y2="8" />
                        <line x1="4" y1="16" x2="20" y2="16" />
                    </svg>
                    Meny
                </button>

                <div class="dropdown-menu bp-meny">
                    @if (erInnlogget)
                    {
                        <div class="bp-meny-hode">
                            <div class="bp-meny-navn">@brukerNavn</div>
                            <div class="bp-meny-rolle">@rolleTekst</div>
                        </div>

                        <a class="bp-meny-lenke @(ErAktiv("Konto") ? "aktiv" : "")" asp-controller="Konto" asp-action="Profil">Min side</a>
                        <span class="bp-meny-lenke deaktivert">Innstillinger <span class="bp-kommer">Kommer</span></span>
                    }
                    else
                    {
                        <a class="bp-meny-lenke" asp-controller="Konto" asp-action="LoggInn">Logg inn</a>
                        <a class="bp-meny-lenke" asp-controller="Konto" asp-action="Registrer">Registrer bruker</a>
                    }

                    @* Engelsk versjon er ikke laget ennå, så "English" er bare vist. *@
                    <div class="bp-meny-sprak">
                        <span class="bp-meny-sprak-etikett">Språk / Language</span>
                        <span class="bp-meny-sprak-valg">
                            <span class="aktiv">Norsk</span>
                            <span class="deaktivert" title="Kommer senere">English</span>
                        </span>
                    </div>

                    @if (erInnlogget)
                    {
                        <form asp-controller="Konto" asp-action="LoggUt" method="post">
                            <button type="submit" class="bp-meny-lenke bp-meny-loggut">Logg ut</button>
                        </form>
                    }
                </div>
            </div>

            <a class="bp-logo" asp-controller="Home" asp-action="Index" aria-label="BeredskapsPortalen, til forsiden">
                <partial name="_Logo" />
                <span class="bp-logo-tekst">BeredskapsPortalen</span>
            </a>

            <nav class="bp-nav @(erInnlogget ? "bp-nav-innlogget" : "")" aria-label="Hovedmeny">
                @if (erInnlogget)
                {
                    <ul class="bp-nav-lenker">
                        <li><a class="bp-nav-link @(ErAktiv("Oversikt") ? "aktiv" : "")" asp-controller="Oversikt" asp-action="Index">Oversikt</a></li>
                        @* Kart og Behov vises bare for offentlige aktører. Private aktører tilbyr bare ressurser. *@
                        @if (User.IsInRole("OffentligAktor"))
                        {
                            <li><a class="bp-nav-link @(ErAktiv("Kart") ? "aktiv" : "")" asp-controller="Kart" asp-action="Index">Kart</a></li>
                            <li><a class="bp-nav-link @(ErAktiv("Behov") ? "aktiv" : "")" asp-controller="Behov" asp-action="Index">Behov</a></li>
                        }
                        <li><a class="bp-nav-link @(ErAktiv("Ressurs") ? "aktiv" : "")" asp-controller="Ressurs" asp-action="Index">Ressurser</a></li>
                    </ul>
                }
                else
                {
                    <ul class="bp-nav-lenker">
                        <li>
                            <a class="bp-nav-link @(ErAktiv("Konto") ? "aktiv" : "")" asp-controller="Konto" asp-action="LoggInn">
                                Logg inn
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <circle cx="12" cy="7" r="4" />
                                    <path d="M5 21v-2a5 5 0 0 1 5-5h4a5 5 0 0 1 5 5v2" />
                                </svg>
                            </a>
                        </li>
                    </ul>
                }
            </nav>
        </div>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    @* Kartsiden bruker hele skjermen, så der viser vi ikke footeren. *@
    @if (!ErAktiv("Kart"))
    {
        <footer class="bp-footer">
            <div class="bp-footer-innhold">
                <div>
                    <p class="bp-footer-navn">BeredskapsPortalen</p>
                    <p>Et studentprosjekt for koordinering av ressurser ved en nasjonal krise.</p>
                </div>
                <p class="bp-footer-liten">&copy; 2026 Universitetet i Agder. Levert som del av beredskap og krisehåndtering.</p>
            </div>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

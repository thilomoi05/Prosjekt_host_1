@model ForsideViewModel
@{
    ViewData["Title"] = "Hjem";

    // Er brukeren logget inn? Styrer hva toppseksjonen viser.
    var erInnlogget = User.Identity?.IsAuthenticated ?? false;

    // Fornavnet til brukeren, f.eks. "Test" fra "Test Testesen".
    var fulltNavn = User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? "";
    var fornavn = fulltNavn.Split(' ')[0];

    // Offentlige aktører melder behov, private aktører tilbyr ressurser.
    var erOffentligAktor = User.IsInRole("OffentligAktor");
}

@* Toppseksjonen: kartet fra appen ligger i bakgrunnen (satt i site.css, "Forsiden: toppseksjon"). *@
<section class="bp-hero">
    <div class="bp-hero-innhold">
        <div class="bp-hero-tekst">
            @if (erInnlogget)
            {
                <h1>Velkommen tilbake, @fornavn</h1>

                @if (erOffentligAktor)
                {
                    <p class="bp-hero-ingress">Se hva som trengs og hvor ressursene er, eller meld inn et nytt behov.</p>
                }
                else
                {
                    <p class="bp-hero-ingress">Takk for at du bidrar. Registrer ressursene du kan tilby, så kan de settes inn der de trengs mest.</p>
                }
            }
            else
            {
                <h1>Riktig ressurs.<br />På riktig sted.<br />Når det gjelder.</h1>
                <p class="bp-hero-ingress">
                    BeredskapsPortalen kobler behov fra offentlige aktører med ressurser fra
                    bedrifter og privatpersoner. Sammen styrker vi beredskapen i Norge.
                </p>
            }

            <div class="bp-hero-knapper">
                @if (!erInnlogget)
                {
                    <a class="btn btn-bp-primær" asp-controller="Konto" asp-action="LoggInn">Logg inn &rarr;</a>
                    <a class="btn btn-bp-sekundær" asp-controller="Konto" asp-action="Registrer">Registrer bruker</a>
                }
                else if (erOffentligAktor)
                {
                    <a class="btn btn-bp-primær" asp-controller="Behov" asp-action="Registrer">Meld inn behov</a>
                    <a class="btn btn-bp-sekundær" asp-controller="Kart" asp-action="Index">Se kartet</a>
                }
                else
                {
                    <a class="btn btn-bp-primær" asp-controller="Ressurs" asp-action="Registrer">Tilby ressurs</a>
                    <a class="btn btn-bp-sekundær" asp-controller="Oversikt" asp-action="Index">Gå til oversikt</a>
                }
            </div>
        </div>
    </div>

    @* Kartet i bakgrunnen er fra Kartverket, derfor står kilden her. *@
    <p class="bp-hero-kilde">Kart: &copy; Kartverket</p>
</section>

<div class="bp-forside-innhold">

    @* Scenarioet fra casen, med en kort forklaring av hva portalen gjør til høyre. *@
    <section class="bp-scenario">
        <div class="bp-scenario-tekst">
            <div class="bp-ikon-rund bp-farge-behov" aria-hidden="true">
                @* Varseltrekant *@
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z" />
                    <line x1="12" y1="9" x2="12" y2="13" />
                    <line x1="12" y1="17" x2="12.01" y2="17" />
                </svg>
            </div>
            <div>
                <span class="bp-scenario-etikett">Tenk deg situasjonen</span>
                <h2>Et nasjonalt cyberangrep lammer samfunnet</h2>
                <p>
                    Flere offentlige systemer er utilgjengelige etter et koordinert cyberangrep.
                    Kommuner mister tilgang til kritiske tjenester, sykehus får redusert drift, og
                    kommunikasjonen mellom aktørene fungerer ikke som normalt. Behovet for
                    reservesamband, teknisk støtte og annet utstyr meldes inn raskt, ofte fra
                    flere steder samtidig.
                </p>
            </div>
        </div>

        <div class="bp-scenario-info">
            <div class="bp-ikon-rund bp-farge-fjord" aria-hidden="true">
                @* Logoen (Views/Shared/_Logo.cshtml) *@
                <partial name="_Logo" />
            </div>
            <div>
                <h3>BeredskapsPortalen gjør ressursene synlige</h3>
                <p>
                    Behovet meldes inn, ressursen er registrert, og autoriserte aktører finner
                    begge på kartet.
                </p>
            </div>
        </div>
    </section>

    <div class="bp-seksjon-hode">
        <h2>Slik fungerer det</h2>
        <p>Tre steg fra behov til hjelp.</p>
    </div>

    @* Stegene er en rekkefølge, derfor en nummerert liste (<ol>). Fargene følger kartet:
       magenta = behov, marineblå = ressurs, oransje = koordinering. *@
    <ol class="bp-steg-flyt">
        <li class="bp-steg">
            <div class="bp-steg-topp">
                <span class="bp-steg-nummer bp-farge-behov">1</span>
                <div class="bp-ikon-firkant bp-farge-behov" aria-hidden="true">
                    @* Blyant *@
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 20h9" />
                        <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />
                    </svg>
                </div>
            </div>
            <h3>Behov meldes inn</h3>
            <p>
                Heimevernet, kommuner og andre autoriserte aktører melder inn hva som trengs og
                hvor, for eksempel nødstrøm, drivstoff eller kommunikasjonsutstyr.
            </p>
        </li>

        <li class="bp-steg-pil" aria-hidden="true">&rarr;</li>

        <li class="bp-steg">
            <div class="bp-steg-topp">
                <span class="bp-steg-nummer bp-farge-ressurs">2</span>
                <div class="bp-ikon-firkant bp-farge-ressurs" aria-hidden="true">
                    @* Lastebil *@
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="1" y="7" width="14" height="10" rx="1" />
                        <path d="M15 10h3l4 4v3h-7z" />
                        <circle cx="6" cy="19.5" r="1.5" />
                        <circle cx="17.5" cy="19.5" r="1.5" />
                    </svg>
                </div>
            </div>
            <h3>Ressurser tilbys</h3>
            <p>
                Bedrifter, entreprenører og privatpersoner registrerer hva de kan bidra med, som
                aggregater, drivstoff eller transport.
            </p>
        </li>

        <li class="bp-steg-pil" aria-hidden="true">&rarr;</li>

        <li class="bp-steg">
            <div class="bp-steg-topp">
                <span class="bp-steg-nummer bp-farge-signal">3</span>
                <div class="bp-ikon-firkant bp-farge-signal" aria-hidden="true">
                    @* Kart *@
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M1 6v16l7-4 8 4 7-4V2l-7 4-8-4-7 4Z" />
                        <line x1="8" y1="2" x2="8" y2="18" />
                        <line x1="16" y1="6" x2="16" y2="22" />
                    </svg>
                </div>
            </div>
            <h3>Hjelpen koordineres</h3>
            <p>
                Autoriserte brukere ser behov og ressurser samlet på kartet, og kan sende hjelpen
                dit den gjør mest nytte.
            </p>
        </li>
    </ol>

    <div class="bp-seksjon-hode">
        <h2>Hvem er portalen for?</h2>
        <p>Både offentlige aktører og private kan bidra.</p>
    </div>

    @* Ikonene er de samme som på kartet: nål = behov, firkant = ressurs.
       SVG-koden er kopiert fra wwwroot/js/kartikoner.js. *@
    <div class="bp-malgruppe-grid">
        <section class="bp-malgruppe bp-farge-behov">
            <div class="bp-malgruppe-hode">
                <div class="bp-ikon-rund" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="34" height="34">
                        <path fill="currentColor" stroke="white" stroke-width="2" stroke-linejoin="round" d="M12 1.5C6.2 1.5 2 5.8 2 11.1c0 6.2 10 11.4 10 11.4s10-5.2 10-11.4C22 5.8 17.8 1.5 12 1.5z" />
                        <g transform="translate(4.8 3.6) scale(0.6)"><path fill="white" d="M13.5 2.5 5.5 13h6l-1 8.5L19 10.5h-6z" /></g>
                    </svg>
                </div>
                <div>
                    <h3>Offentlige aktører</h3>
                    <p class="bp-malgruppe-hvem">Heimevernet, kommuner, sykehus og andre beredskapsaktører</p>
                </div>
            </div>
            <ul class="bp-sjekkliste">
                <li>Meld inn behov med type, prioritet og posisjon</li>
                <li>Se alle behov og tilgjengelige ressurser på kartet</li>
                <li>Se bilder og kontaktinfo til ressursene</li>
                <li>Følg status fra nytt behov til fullført</li>
            </ul>
            @if (!erInnlogget)
            {
                <a class="btn btn-bp-primær" asp-controller="Konto" asp-action="Registrer" asp-route-rolle="OffentligAktor">Registrer deg som offentlig aktør</a>
            }
        </section>

        <section class="bp-malgruppe bp-farge-ressurs">
            <div class="bp-malgruppe-hode">
                <div class="bp-ikon-rund" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="34" height="34">
                        <rect x="1.5" y="1.5" width="21" height="21" rx="4" fill="currentColor" stroke="white" stroke-width="2" />
                        <g transform="translate(4.8 4.8) scale(0.6)"><path fill="white" d="M2 5h12v12H2zM15 9h4l3 4v4h-7z" /><circle fill="white" cx="6" cy="18" r="2.5" /><circle fill="white" cx="18.5" cy="18" r="2.5" /></g>
                    </svg>
                </div>
                <div>
                    <h3>Bedrifter og privatpersoner</h3>
                    <p class="bp-malgruppe-hvem">Entreprenører, transportfirmaer, bønder og alle andre som har noe å bidra med</p>
                </div>
            </div>
            <ul class="bp-sjekkliste">
                <li>Registrer utstyr, kjøretøy eller kompetanse du kan stille med</li>
                <li>Oppgi hvor ressursen er og når den er tilgjengelig</li>
                <li>Legg ved bilder, så det er lett å se hva du tilbyr</li>
                <li>Posisjonen vises bare for autoriserte aktører</li>
            </ul>
            @if (!erInnlogget)
            {
                <a class="btn btn-bp-primær" asp-controller="Konto" asp-action="Registrer" asp-route-rolle="PrivatAktor">Registrer deg og tilby ressurser</a>
            }
        </section>
    </div>
</div>

@model ForsideViewModel
@{
    ViewData["Title"] = "Hjem";

    // Er brukeren logget inn? Styrer hva flisene og knappene viser.
    var erInnlogget = User.Identity?.IsAuthenticated ?? false;

    // Fornavnet til brukeren, f.eks. "Test" fra "Test Testesen".
    var fulltNavn = User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? "";
    var fornavn = fulltNavn.Split(' ')[0];

    // Offentlige aktører melder behov, private aktører tilbyr ressurser.
    var erOffentligAktor = User.IsInRole("OffentligAktor");
}

@* =========================================================================
   Toppen: tre fliser (som bildene på forsvaret.no) og hurtigknapper under.
   Flisene har mørke mønstre i stedet for fotografier, se .bp-flis-a/-b/-c i site.css.
   ========================================================================= *@
<section class="bp-topp">
    <div class="bp-flis-grid">
        <a class="bp-flis bp-flis-stor bp-flis-a" href="#situasjonen">
            <span class="bp-flis-bilde" aria-hidden="true"></span>
            <svg class="bp-flis-motiv" width="260" height="260" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.6" stroke-linejoin="round" aria-hidden="true">
                <path d="M13 2 4 14h6l-1 8 9-12h-6l1-8Z" />
            </svg>
            <span class="bp-flis-tekst">
                <span class="bp-flis-etikett">@(erInnlogget ? $"Velkommen tilbake, {fornavn}:" : "BeredskapsPortalen:")</span>
                <span class="bp-flis-tittel">Når strømmen går, teller hver time</span>
            </span>
        </a>

        <a class="bp-flis bp-flis-liten bp-flis-b" asp-controller="Behov" asp-action="Index">
            <span class="bp-flis-bilde" aria-hidden="true"></span>
            <svg class="bp-flis-motiv" width="150" height="150" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z" />
                <circle cx="12" cy="9.5" r="2.5" />
            </svg>
            <span class="bp-flis-tekst">
                <span class="bp-flis-etikett">@Model.AntallAkutteBehov akutte av @Model.AntallAktiveBehov aktive:</span>
                <span class="bp-flis-tittel">Se meldte behov</span>
            </span>
        </a>

        <a class="bp-flis bp-flis-liten bp-flis-c" asp-controller="Ressurs" asp-action="Index">
            <span class="bp-flis-bilde" aria-hidden="true"></span>
            <svg class="bp-flis-motiv" width="150" height="150" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="1" y="7" width="14" height="10" rx="1" />
                <path d="M15 10h3l4 4v3h-7z" />
                <circle cx="6" cy="19.5" r="1.5" />
                <circle cx="17.5" cy="19.5" r="1.5" />
            </svg>
            <span class="bp-flis-tekst">
                <span class="bp-flis-etikett">@Model.AntallTilgjengeligeRessurser tilgjengelige nå:</span>
                <span class="bp-flis-tittel">Ressurser i beredskap</span>
            </span>
        </a>
    </div>

    @* Hurtigknappene: de vanligste oppgavene for hver brukertype. *@
    <ul class="bp-hurtig-knapper">
        @if (!erInnlogget)
        {
            <li><a class="bp-hurtig-knapp" asp-controller="Konto" asp-action="LoggInn">Logg inn</a></li>
            <li><a class="bp-hurtig-knapp" asp-controller="Konto" asp-action="Registrer">Registrer bruker</a></li>
            <li><a class="bp-hurtig-knapp" href="#slik-fungerer-det">Slik fungerer det</a></li>
            <li><a class="bp-hurtig-knapp" href="#hvem">Hvem er portalen for?</a></li>
        }
        else if (erOffentligAktor)
        {
            <li><a class="bp-hurtig-knapp" asp-controller="Behov" asp-action="Registrer">Meld inn behov</a></li>
            <li><a class="bp-hurtig-knapp" asp-controller="Kart" asp-action="Index">Kart</a></li>
            <li><a class="bp-hurtig-knapp" asp-controller="Oversikt" asp-action="Index">Oversikt</a></li>
            <li><a class="bp-hurtig-knapp" asp-controller="Ressurs" asp-action="Index">Ressurser</a></li>
            <li><a class="bp-hurtig-knapp" asp-controller="Konto" asp-action="Profil">Min profil</a></li>
        }
        else
        {
            <li><a class="bp-hurtig-knapp" asp-controller="Ressurs" asp-action="Registrer">Tilby ressurs</a></li>
            <li><a class="bp-hurtig-knapp" asp-controller="Oversikt" asp-action="Index">Oversikt</a></li>
            <li><a class="bp-hurtig-knapp" asp-controller="Kart" asp-action="Index">Kart</a></li>
            <li><a class="bp-hurtig-knapp" asp-controller="Konto" asp-action="Profil">Min profil</a></li>
        }
    </ul>
</section>

@* =========================================================================
   Situasjonen: "bilde" til venstre, grå flate med tekst til høyre.
   ========================================================================= *@
<section class="bp-blokker" id="situasjonen">
    <div class="bp-blokk bp-blokk-venstre">
        <div class="bp-blokk-flate" aria-hidden="true"></div>
        <div class="bp-blokk-bilde" aria-hidden="true">
            <svg width="72" height="72" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round">
                <path d="M13 2 4 14h6l-1 8 9-12h-6l1-8Z" />
            </svg>
            <span class="bp-blokk-bilde-tekst">Tenk deg<br />situasjonen</span>
        </div>
        <div class="bp-blokk-tekst">
            <h3>Når strømmen går, teller hver time</h3>
            <p>
                En storm har slått ut strømmen i flere kommuner på Sørlandet. Sykehjemmet trenger
                aggregat, og mobilnettet begynner å falle ut. Samtidig står en entreprenør med tre
                ledige aggregater 20 kilometer unna. Men ingen vet om hverandre.
            </p>
            <p>
                BeredskapsPortalen kobler dem sammen: behovet meldes inn, ressursen er allerede
                registrert, og Heimevernet ser begge på kartet.
            </p>
            <a class="bp-pil-lenke" href="#slik-fungerer-det" aria-label="Slik fungerer det">
                <svg width="36" height="20" viewBox="0 0 36 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="1" y1="10" x2="34" y2="10" />
                    <polyline points="26,2 34,10 26,18" />
                </svg>
            </a>
        </div>
    </div>
</section>

@* =========================================================================
   Slik fungerer det: tre steg
   ========================================================================= *@
<section class="bp-seksjon" id="slik-fungerer-det">
    <h2>Slik fungerer det</h2>
    <div class="bp-steg-flyt">
        <div class="bp-kort bp-steg">
            <div class="bp-steg-topp">
                <span class="bp-steg-nummer">1</span>
                <div class="bp-ikon-sirkel">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 20h9" />
                        <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />
                    </svg>
                </div>
            </div>
            <h3>Behov meldes inn</h3>
            <p>
                Heimevernet, kommunen og andre autoriserte aktører melder inn hva som trengs
                og hvor, for eksempel nødstrøm, drivstoff eller kommunikasjonsutstyr.
            </p>
        </div>

        <div class="bp-steg-pil" aria-hidden="true">
            <svg width="28" height="16" viewBox="0 0 36 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <line x1="1" y1="10" x2="34" y2="10" />
                <polyline points="26,2 34,10 26,18" />
            </svg>
        </div>

        <div class="bp-kort bp-steg">
            <div class="bp-steg-topp">
                <span class="bp-steg-nummer">2</span>
                <div class="bp-ikon-sirkel">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="1" y="7" width="14" height="10" rx="1" />
                        <path d="M15 10h3l4 4v3h-7z" />
                        <circle cx="6" cy="19.5" r="1.5" />
                        <circle cx="17.5" cy="19.5" r="1.5" />
                    </svg>
                </div>
            </div>
            <h3>Ressurser tilbys</h3>
            <p>
                Bedrifter, entreprenører og privatpersoner registrerer hva de kan bidra med,
                som aggregater, drivstoff eller transport.
            </p>
        </div>

        <div class="bp-steg-pil" aria-hidden="true">
            <svg width="28" height="16" viewBox="0 0 36 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <line x1="1" y1="10" x2="34" y2="10" />
                <polyline points="26,2 34,10 26,18" />
            </svg>
        </div>

        <div class="bp-kort bp-steg">
            <div class="bp-steg-topp">
                <span class="bp-steg-nummer">3</span>
                <div class="bp-ikon-sirkel">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z" />
                        <circle cx="12" cy="9.5" r="2.5" />
                    </svg>
                </div>
            </div>
            <h3>Hjelpen koordineres</h3>
            <p>
                Autoriserte brukere ser behov og ressurser samlet på kartet, og kan sende
                hjelpen dit den gjør mest nytte.
            </p>
        </div>
    </div>
</section>

@* =========================================================================
   Hvem er portalen for? To blokker som veksler side (som på forsvaret.no)
   ========================================================================= *@
<section class="bp-blokker" id="hvem">
    <h2>Hvem er portalen for?</h2>

    <div class="bp-blokk bp-blokk-venstre">
        <div class="bp-blokk-flate" aria-hidden="true"></div>
        <div class="bp-blokk-bilde" aria-hidden="true">
            <svg width="72" height="72" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2 4 5v6c0 5 3.5 8.5 8 11 4.5-2.5 8-6 8-11V5l-8-3Z" />
            </svg>
            <span class="bp-blokk-bilde-tekst">Offentlige<br />aktører</span>
        </div>
        <div class="bp-blokk-tekst">
            <h3>Meld inn behov og se hvor ressursene er</h3>
            <p class="bp-blokk-hvem">Heimevernet, kommuner, sykehus og andre beredskapsaktører.</p>
            <p>
                Meld inn behov med type, prioritet og posisjon. Se alle behov og tilgjengelige
                ressurser på kartet, med bilder og kontaktinfo, og følg status fra nytt behov til fullført.
            </p>
            @if (!erInnlogget)
            {
                <a class="bp-pil-lenke" asp-controller="Konto" asp-action="Registrer" asp-route-rolle="OffentligAktor">
                    <span>Registrer deg som offentlig aktør</span>
                    <svg width="36" height="20" viewBox="0 0 36 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="1" y1="10" x2="34" y2="10" />
                        <polyline points="26,2 34,10 26,18" />
                    </svg>
                </a>
            }
        </div>
    </div>

    <div class="bp-blokk bp-blokk-hoyre">
        <div class="bp-blokk-flate" aria-hidden="true"></div>
        <div class="bp-blokk-tekst">
            <h3>Tilby det du kan bidra med</h3>
            <p class="bp-blokk-hvem">Entreprenører, transportfirmaer, bønder og alle andre som har noe å bidra med.</p>
            <p>
                Registrer utstyr, kjøretøy eller kompetanse, oppgi hvor ressursen er og når den er
                tilgjengelig, og legg ved bilder. Posisjonen vises bare for autoriserte aktører.
            </p>
            @if (!erInnlogget)
            {
                <a class="bp-pil-lenke" asp-controller="Konto" asp-action="Registrer" asp-route-rolle="PrivatAktor">
                    <span>Registrer deg og tilby ressurser</span>
                    <svg width="36" height="20" viewBox="0 0 36 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="1" y1="10" x2="34" y2="10" />
                        <polyline points="26,2 34,10 26,18" />
                    </svg>
                </a>
            }
        </div>
        <div class="bp-blokk-bilde" aria-hidden="true">
            <svg width="72" height="72" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="1" y="7" width="14" height="10" rx="1" />
                <path d="M15 10h3l4 4v3h-7z" />
                <circle cx="6" cy="19.5" r="1.5" />
                <circle cx="17.5" cy="19.5" r="1.5" />
            </svg>
            <span class="bp-blokk-bilde-tekst">Bedrifter og<br />privatpersoner</span>
        </div>
    </div>
</section>

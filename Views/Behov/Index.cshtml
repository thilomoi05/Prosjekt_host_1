@model IReadOnlyList<Behov>
@{
    ViewData["Title"] = "Behov";

    // Valgene i filtermenyene lages ut fra behovene som finnes, så nye typer og
    // områder kommer med av seg selv.
    var typer = Model
        .GroupBy(b => b.Type)
        .Select(g => (Verdi: g.Key.ToString(), Tekst: g.First().VisningsNavn))
        .OrderBy(t => t.Tekst)
        .ToList();

    var omrader = Model
        .Select(b => b.GeografiskOmrade)
        .Distinct()
        .OrderBy(o => o)
        .Select(o => (Verdi: o, Tekst: o))
        .ToList();

    // Prioritet og status har faste valg, i den rekkefølgen som gir mening.
    var prioriteter = new[] { Prioritet.Hoy, Prioritet.Moderat, Prioritet.Lav }
        .Select(p => (Verdi: PrioritetVisning.CssNavn(p), Tekst: PrioritetVisning.Tekst(p)))
        .ToList();

    var statuser = new List<(string Verdi, string Tekst)> { ("Venter", "Venter"), ("Tildelt", "Tildelt") };
}

<div class="bp-side-innhold">
    <div class="bp-tabell-kort">
        <div class="bp-tabell-kort-hode">
            <div>
                <h2>Alle meldte behov</h2>
                @* Teksten og "Nullstill filter" oppdateres av tabellfilter.js. *@
                <p class="bp-filter-status">
                    <span id="tabell-antall">Viser @Model.Count behov</span>
                    <button type="button" class="bp-filter-nullstill" id="tabell-nullstill" hidden>Nullstill filter</button>
                </p>
            </div>
            <a class="btn btn-bp-primær" asp-controller="Behov" asp-action="Registrer">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" style="vertical-align: -2px; margin-right: 0.35rem;">
                    <line x1="12" y1="5" x2="12" y2="19" />
                    <line x1="5" y1="12" x2="19" y2="12" />
                </svg>
                Registrer nytt behov
            </a>
        </div>

        <div class="table-responsive bp-tabell-med-filter">
            @* data-enhet er ordet i "Viser 8 av 12 behov" (tabellfilter.js). *@
            <table class="bp-tabell bp-tabell-ikoner" id="filtertabell" data-enhet="behov">
                <thead>
                    <tr>
                        <th><partial name="_Filtermeny" model='("Type behov", "type", typer)' /></th>
                        <th><partial name="_Filtermeny" model='("Område", "omrade", omrader)' /></th>
                        <th><partial name="_Filtermeny" model='("Prioritet", "prioritet", prioriteter)' /></th>
                        <th><partial name="_Filtermeny" model='("Status", "status", statuser)' /></th>
                        @* Dato: sortering i stedet for filter *@
                        <th><partial name="_Datosortering" model='"Dato"' /></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var behov in Model)
                    {
                        @* data-rad markerer raden for tabellfilter.js. De andre data-* er verdiene filteret og sorteringen bruker. *@
                        <tr data-rad
                            data-type="@behov.Type"
                            data-omrade="@behov.GeografiskOmrade"
                            data-prioritet="@PrioritetVisning.CssNavn(behov.Prioritet)"
                            data-status="@behov.Status"
                            data-dato="@behov.Dato.ToString("yyyy-MM-dd")">
                            <td>
                                @* Samme ikon som på kartet, i fargen til prioriteten. Fylles inn av tabellfilter.js.
                                   Navnet er en lenke til detaljsiden for behovet (Behov/Detaljer/id). *@
                                <span class="bp-kartikon bp-ikon-@PrioritetVisning.CssNavn(behov.Prioritet)" data-ikon-type="@behov.Type"></span>
                                <a class="bp-oversikt-lenke" asp-controller="Behov" asp-action="Detaljer" asp-route-id="@behov.Id">@behov.VisningsNavn</a>
                            </td>
                            <td>@behov.GeografiskOmrade</td>
                            @* Tekst og farge for prioriteten kommer fra PrioritetVisning (Models/PrioritetVisning.cs). *@
                            <td class="bp-prioritet-@PrioritetVisning.CssNavn(behov.Prioritet)">
                                @PrioritetVisning.Tekst(behov.Prioritet)
                            </td>
                            <td>
                                @{
                                    var (cssKlasse, tekst) = behov.Status switch
                                    {
                                        BehovStatus.Tildelt => ("bp-badge-tildelt", "Tildelt"),
                                        _ => ("bp-badge-venter", "Venter")
                                    };
                                }
                                <span class="bp-badge @cssKlasse">@tekst</span>
                            </td>
                            <td>@behov.Dato.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                    @* Vises av tabellfilter.js når ingen behov passer filteret. *@
                    <tr id="tabell-tom" hidden>
                        <td colspan="5" class="bp-oversikt-tom">Ingen behov passer filteret. Trykk «Nullstill filter» for å se alle.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    @* kartikoner.js har funksjonen lagIkonSvg, som lager de samme ikonene som på kartet. *@
    <script src="~/js/kartikoner.js" asp-append-version="true"></script>
    <script src="~/js/tabellfilter.js" asp-append-version="true"></script>
}

@model RessursViewModel
@{
    ViewData["Title"] = "Tilby ressurs";

    // Typene brukeren kan velge, med teksten som vises på knappene.
    // Navnene til venstre er de samme som i enumen RessursType (Models/Enums.cs).
    var typer = new (string Verdi, string Tekst)[]
    {
        ("Aggregat", "Aggregat"),
        ("Drivstoff", "Drivstoff"),
        ("Ups", "UPS (batteri)"),
        ("Transport", "Transport"),
        ("Kommunikasjonsutstyr", "Samband"),
        ("Annet", "Annet")
    };

    // "Tilgjengelig nå, på ubestemt tid" er krysset av hvis ingen datoer er fylt inn.
    var paUbestemtTid = Model.TilgjengeligFra is null && Model.TilgjengeligTil is null;
}

@* =========================================================================
   Skjemaet for å tilby en ressurs, delt i tre steg så det ikke virker
   overveldende. Det er fortsatt ETT skjema som sendes én gang til serveren.
   Stegene vises og skjules av wwwroot/js/ressursskjema.js, som også sjekker
   feltene i hvert steg før man går videre.
   ========================================================================= *@
<div class="bp-skjema-side">
    <div class="bp-steg-skjema">
        <h1>Tilby ressurs</h1>
        <p class="bp-steg-skjema-ingress">
            Tre korte steg. Det du registrerer, kan Heimevernet og kommunene sette inn der det trengs.
        </p>

        @* Fremdriftslinjen. ressursskjema.js setter klassene "aktiv" og "ferdig". *@
        <ol class="bp-fremdrift" id="fremdrift">
            <li data-steg="1"><span class="bp-fremdrift-nummer">1</span> Hva tilbyr du?</li>
            <li data-steg="2"><span class="bp-fremdrift-nummer">2</span> Hvor er den?</li>
            <li data-steg="3"><span class="bp-fremdrift-nummer">3</span> Når og hvem?</li>
        </ol>

        @* enctype="multipart/form-data" må være med for at skjemaet skal kunne sende filer (bildene). *@
        <form asp-controller="Ressurs" asp-action="Registrer" method="post" enctype="multipart/form-data" id="ressursskjema">

            @* ---------------- Steg 1: Hva tilbyr du? ---------------- *@
            <section class="bp-steg-innhold" data-steg="1">
                <h2>Hva tilbyr du?</h2>

                <fieldset class="mb-4">
                    <legend class="form-label">Type ressurs</legend>
                    @* Hver type er en radioknapp som ser ut som en stor knapp med ikon.
                       Ikonet (samme som på kartet) settes inn av ressursskjema.js. *@
                    <div class="bp-type-valg">
                        @foreach (var (verdi, tekst) in typer)
                        {
                            <label class="bp-type-knapp">
                                <input type="radio" asp-for="Type" value="@verdi" />
                                <span class="bp-kartikon bp-ikon-ressurs" data-ikon-type="@verdi"></span>
                                <span>@tekst</span>
                            </label>
                        }
                    </div>
                    <span asp-validation-for="Type" class="text-danger"></span>
                </fieldset>

                <div class="mb-4">
                    <label asp-for="BeskrivelseAvKapasitet" class="form-label"></label>
                    @* Eksempelteksten byttes etter valgt type (se ressursskjema.js). *@
                    <textarea asp-for="BeskrivelseAvKapasitet" class="form-control" rows="3"
                              placeholder="Beskriv ressursen, f.eks. størrelse, kapasitet og om noen kan betjene den."></textarea>
                    <span asp-validation-for="BeskrivelseAvKapasitet" class="text-danger"></span>
                </div>

                @* Bilder: hele feltet er en filvelger, så man kan klikke eller dra bilder inn.
                   type="file" + multiple = flere filer, accept="image/*" = bare bilder. *@
                <div class="mb-2">
                    <label asp-for="Bilder" class="form-label"></label>
                    <div class="bp-bildefelt">
                        <input asp-for="Bilder" type="file" multiple accept="image/jpeg,image/png,image/webp" />
                        <span class="bp-bildefelt-tekst">
                            <strong>Velg bilder</strong> eller dra dem hit
                            <span>Minst ett bilde, maks 5. JPG, PNG eller WEBP, opptil 5 MB per bilde.</span>
                        </span>
                    </div>
                    @* Små forhåndsvisninger av valgte bilder, lages av ressursskjema.js *@
                    <div class="bp-bilde-forhandsvisning" id="bilde-forhandsvisning"></div>
                    <p class="bp-skjema-hjelp mt-1">Bildene viser at ressursen finnes, og hjelper Heimevernet å se hva det er.</p>
                    <span asp-validation-for="Bilder" class="text-danger" id="bilder-feil"></span>
                </div>
            </section>

            @* ---------------- Steg 2: Hvor er den? ---------------- *@
            <section class="bp-steg-innhold" data-steg="2" hidden>
                <h2>Hvor er den?</h2>

                @* 1. Brukeren skriver adressen og trykker "Finn på kartet".
                   2. posisjonsvelger.js spør Kartverket om adressen og setter en markør.
                   3. Står markøren feil, klikker brukeren der ressursen faktisk er. *@
                <div class="mb-3">
                    <label asp-for="Adresse" class="form-label"></label>
                    <div class="bp-adressesok">
                        <input asp-for="Adresse" class="form-control" placeholder="F.eks. Kirkegata 5, Kristiansand" autocomplete="street-address" />
                        <button type="button" id="finn-adresse" class="btn btn-bp-primær">Finn på kartet</button>
                    </div>
                    <span asp-validation-for="Adresse" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    @* Tekst som posisjonsvelger.js oppdaterer, f.eks. "Fant: Kirkegata 5 ..." *@
                    <p id="adresse-melding" class="bp-skjema-hjelp">
                        Skriv adressen og trykk «Finn på kartet». Står markøren feil, klikker du der ressursen faktisk er.
                    </p>
                    @* Kartet. Styres av wwwroot/js/posisjonsvelger.js. *@
                    <div id="posisjonsvelger" class="bp-posisjonsvelger bp-posisjonsvelger-stor"></div>
                    @* Skjulte felt som posisjonsvelger.js fyller inn. *@
                    <input asp-for="Breddegrad" type="hidden" />
                    <input asp-for="Lengdegrad" type="hidden" />
                    <span asp-validation-for="Breddegrad" class="text-danger" id="plassering-feil"></span>
                </div>

                <div class="mb-2">
                    <label asp-for="Tilgangsbeskrivelse" class="form-label"></label>
                    <textarea asp-for="Tilgangsbeskrivelse" class="form-control" rows="3"
                              placeholder="F.eks. Står i garasjen bak huset. Kodelås på døra, koden er 1234."></textarea>
                    <p class="bp-skjema-hjelp mt-1">Vises bare for Heimevernet og andre autoriserte brukere.</p>
                    <span asp-validation-for="Tilgangsbeskrivelse" class="text-danger"></span>
                </div>
            </section>

            @* ---------------- Steg 3: Når og hvem? ---------------- *@
            <section class="bp-steg-innhold" data-steg="3" hidden>
                <h2>Når og hvem?</h2>

                <div class="mb-4">
                    <span class="form-label d-block">Når er den tilgjengelig?</span>
                    <label class="bp-avkryssing">
                        @* Ikke en del av modellen: bare en snarvei som skjuler datoene (ressursskjema.js). *@
                        <input type="checkbox" id="tilgjengelig-na" @(paUbestemtTid ? "checked" : "") />
                        Tilgjengelig nå, på ubestemt tid
                    </label>
                    <div class="row mt-2" id="datoer" @(paUbestemtTid ? "hidden" : "")>
                        <div class="col-6">
                            <label asp-for="TilgjengeligFra" class="form-label"></label>
                            <input asp-for="TilgjengeligFra" class="form-control" />
                        </div>
                        <div class="col-6">
                            <label asp-for="TilgjengeligTil" class="form-label"></label>
                            <input asp-for="TilgjengeligTil" class="form-control" />
                        </div>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-sm-6 mb-3 mb-sm-0">
                        <label asp-for="Kontaktperson" class="form-label"></label>
                        @* Fylles inn med navnet til den innloggede brukeren (RessursController), men kan endres. *@
                        <input asp-for="Kontaktperson" class="form-control" autocomplete="name" />
                        <span asp-validation-for="Kontaktperson" class="text-danger"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="Telefon" class="form-label"></label>
                        <input asp-for="Telefon" class="form-control" placeholder="F.eks. 400 00 000" autocomplete="tel" inputmode="tel" />
                        <span asp-validation-for="Telefon" class="text-danger"></span>
                    </div>
                </div>

                @* Oppsummering av alt, fylles inn av ressursskjema.js når man kommer til steg 3. *@
                <div class="bp-oppsummering">
                    <h3>Oppsummering</h3>
                    <dl id="oppsummering"></dl>
                </div>
            </section>

            @* Knappene nederst. ressursskjema.js viser og skjuler dem etter hvilket steg man er på. *@
            <div class="bp-steg-knapper">
                <button type="button" class="btn btn-bp-sekundær" id="steg-forrige" hidden>Forrige</button>
                <a class="bp-steg-avbryt" asp-controller="Oversikt" asp-action="Index" id="steg-avbryt">Avbryt</a>
                <button type="button" class="btn btn-bp-primær" id="steg-neste">Neste</button>
                <button type="submit" class="btn btn-bp-primær" id="steg-registrer" hidden>Registrer ressurs</button>
            </div>
        </form>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/lib/leaflet/leaflet.css" />
}

@section Scripts {
    @* jQuery Validation: sjekker feltene i nettleseren ut fra reglene i RessursViewModel. *@
    <partial name="_ValidationScriptsPartial" />
    <script src="~/lib/leaflet/leaflet.js"></script>
    <script src="~/js/kartverket.js" asp-append-version="true"></script>
    <script src="~/js/kartikoner.js" asp-append-version="true"></script>
    <script src="~/js/posisjonsvelger.js" asp-append-version="true"></script>
    <script src="~/js/ressursskjema.js" asp-append-version="true"></script>
}

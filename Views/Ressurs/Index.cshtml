@model IReadOnlyList<RessursRad>
@{
    // Samme side for alle roller, men med ulike kolonner (avtalt i gruppa):
    //  - Offentlige aktører og admin: "Ressurser" med type, adresse, status og "Tilgjengelig fra".
    //    Hvem som tilbød ressursen, vises ikke i lista (personvern). Kontaktperson og telefon står på detaljsiden.
    //  - Private aktører: "Mine ressurser" med bare type, adresse og status, og en knapp for å endre ressursen.
    // Hvilke ressurser hver rolle ser, og rekkefølgen (tilgjengelige øverst, avviste nederst),
    // bestemmes i RessursController.Index.
    var serAlle = User.IsInRole(Roller.OffentligAktor);
    ViewData["Title"] = serAlle ? "Ressurser" : "Mine ressurser";

    // Antall kolonner, brukt av tom-raden nederst: type, adresse, status, og "Tilgjengelig fra"
    // (offentlige) eller knappen "Endre ressursen" (private).
    var antallKolonner = 4;

    // Valgene i filtermenyene lages ut fra ressursene som finnes, så nye typer kommer med av seg selv.
    var typer = Model
        .GroupBy(r => r.Ressurs.Type)
        .Select(g => (Verdi: g.Key.ToString(), Tekst: g.First().Ressurs.VisningsNavn))
        .OrderBy(t => t.Tekst)
        .ToList();

    // Teksten for tildelte ressurser: "Tildelt" for offentlige aktører, som i kartlista og på Behov-siden.
    // Private aktører får "Tildelt et behov", som på Oversikt for private.
    var tildeltTekst = serAlle ? "Tildelt" : "Tildelt et behov";

    // Status har faste valg, i samme rekkefølge som lista. "Venter på godkjenning" og "Avvist" er bare
    // med når noen av ressursene har den statusen (offentlige aktører ser stort sett bare godkjente),
    // så menyen ikke har valg som aldri treffer noe.
    var statuser = new List<(string Verdi, string Tekst)> { ("Tilgjengelig", "Tilgjengelig"), ("Tildelt", tildeltTekst) };
    if (Model.Any(r => r.Ressurs.Status == RessursStatus.Venter))
    {
        statuser.Add(("Venter", "Venter på godkjenning"));
    }
    if (Model.Any(r => r.Ressurs.Status == RessursStatus.Avvist))
    {
        statuser.Add(("Avvist", "Avvist"));
    }

    // Plassen til hver status i lista (data-gruppe på raden), samme rekkefølge som Statusrekkefolge i
    // RessursController. tabellfilter.js sorterer først på denne, så tilgjengelige står øverst og avviste
    // nederst også når man sorterer på dato.
    var statusrekkefolge = new[] { "Tilgjengelig", "Tildelt", "Venter", "Avvist" };

    // Sortering på "Tilgjengelig fra" innenfor hver status: ressurser som er ledige nå (ingen fra-dato,
    // eller en dato som har passert) får dagens dato i data-dato, og lista sorteres eldste først
    // (data-dato-start="eldst" på tabellen). Da står de som er ledige nå først, og deretter de som
    // blir ledige snart.
    var iDag = DateOnly.FromDateTime(DateTime.Now);
}

<div class="bp-side-innhold">
    <div class="bp-tabell-kort">
        <div class="bp-tabell-kort-hode">
            <div>
                <h2>@(serAlle ? "Alle tilbudte ressurser" : "Mine ressurser")</h2>
                @* Teksten og "Nullstill filter" oppdateres av tabellfilter.js. *@
                <p class="bp-filter-status">
                    @* aria-live: skjermlesere leser opp antallet når søket eller filteret endrer det *@
                    <span id="tabell-antall" aria-live="polite">Viser @Model.Count ressurser</span>
                    <button type="button" class="bp-filter-nullstill" id="tabell-nullstill" hidden>Nullstill filter</button>
                </p>
            </div>
            @* Samme knapp som "Registrer nytt behov" på Behov-siden. Offentlige aktører har ingen egen
               "Tilby ressurs"-fane, så for dem er dette veien til skjemaet. Private har også fanen. *@
            <a class="btn btn-bp-primær" asp-controller="Ressurs" asp-action="Registrer">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="bp-knapp-ikon" aria-hidden="true">
                    <line x1="12" y1="5" x2="12" y2="19" />
                    <line x1="5" y1="12" x2="19" y2="12" />
                </svg>
                Tilby ressurs
            </a>
        </div>

        @* Søket gjøres av tabellfilter.js, sammen med filtrene i kolonneoverskriftene. *@
        <partial name="_Sokefelt" model='("tabell-sok", serAlle ? "Søk i ressurser" : "Søk i mine ressurser")' />

        <div class="table-responsive bp-tabell-med-filter">
            @* data-enhet er ordet i "Viser 8 av 12 ressurser" (tabellfilter.js).
               data-dato-start="eldst" gjør at hver status starter med de som er ledige nå (se iDag over). *@
            <table class="bp-tabell bp-tabell-ikoner" id="filtertabell" data-enhet="ressurser" data-dato-start="eldst">
                <thead>
                    <tr>
                        @* Filteret heter "ressurstype", så valgene i menyen får firkant-ikonet (se _Filtermeny). *@
                        <th><partial name="_Filtermeny" model='("Type ressurs", "ressurstype", typer)' /></th>
                        <th>Adresse</th>
                        <th><partial name="_Filtermeny" model='("Status", "status", statuser)' /></th>
                        @if (serAlle)
                        {
                            @* Sorterer på når ressursen er tilgjengelig fra. *@
                            <th><partial name="_Datosortering" model='"Tilgjengelig fra"' /></th>
                        }
                        else
                        {
                            @* Private aktører får en tydelig knapp for å endre ressursen, i stedet for dato.
                               aria-label i stedet for skjult tekst: visually-hidden er position: absolute og
                               gjorde siden bredere enn skjermen på mobil. *@
                            <th aria-label="Endre ressursen"></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rad in Model)
                    {
                        var ressurs = rad.Ressurs;

                        // Status: venter på godkjenning, avvist, tildelt eller tilgjengelig.
                        var (status, cssKlasse, tekst) = ressurs.Status switch
                        {
                            RessursStatus.Venter => ("Venter", "bp-badge-godkjenning", "Venter på godkjenning"),
                            RessursStatus.Avvist => ("Avvist", "bp-badge-avvist", "Avvist"),
                            _ when rad.ErTildelt => ("Tildelt", "bp-badge-tildelt", tildeltTekst),
                            _ => ("Tilgjengelig", "bp-badge-venter", "Tilgjengelig")
                        };

                        // Datoen sorteringen bruker: dagens dato hvis ressursen allerede er ledig (se iDag over).
                        var sorteringsdato = ressurs.TilgjengeligFra is { } fra && fra > iDag ? fra : iDag;

                        @* data-rad markerer raden for tabellfilter.js. De andre data-* er verdiene filteret og sorteringen bruker.
                           data-sok er tekst søket skal treffe selv om den ikke står i tabellen: beskrivelsen av kapasiteten.
                           Hvem som tilbød ressursen (RegistrertAv, kontaktperson) er med vilje ikke med, ellers kunne
                           man finne eieren ved å søke på navnet (personvern, samme grunn som at kolonnen er fjernet). *@
                        <tr data-rad
                            data-sok="@ressurs.BeskrivelseAvKapasitet"
                            data-ressurstype="@ressurs.Type"
                            data-status="@status"
                            data-gruppe="@Array.IndexOf(statusrekkefolge, status)"
                            data-dato="@sorteringsdato.ToString("yyyy-MM-dd")">
                            <td>
                                @* Samme firkant-ikon som på kartet. Fylles inn av tabellfilter.js.
                                   Navnet er en lenke til detaljsiden (Ressurs/Detaljer/id), som på Behov-siden. *@
                                <span class="bp-kartikon bp-ikon-ressurs" data-ikon-type="@ressurs.Type" data-ikon-form="ressurs"></span>
                                <a class="bp-oversikt-lenke" asp-controller="Ressurs" asp-action="Detaljer" asp-route-id="@ressurs.Id">@ressurs.VisningsNavn</a>
                            </td>
                            <td>@ressurs.Adresse</td>
                            <td><span class="bp-badge @cssKlasse">@tekst</span></td>
                            @if (serAlle)
                            {
                                @* Samme datoformat som "Dato" på Behov-siden. Tom fra-dato betyr at den er tilgjengelig nå. *@
                                <td>@(ressurs.TilgjengeligFra?.ToString("yyyy-MM-dd") ?? "Nå")</td>
                            }
                            else
                            {
                                @* Samme knapp og tekst som på detaljsiden, så den er lett å finne fra start. *@
                                <td class="text-end">
                                    <a class="btn btn-bp-primær btn-sm" asp-controller="Ressurs" asp-action="Rediger" asp-route-id="@ressurs.Id">Endre ressursen</a>
                                </td>
                            }
                        </tr>
                    }
                    @* Vises av tabellfilter.js når ingen ressurser passer søket eller filteret, eller når lista er tom. *@
                    <tr id="tabell-tom" hidden>
                        <td colspan="@antallKolonner" class="bp-oversikt-tom">
                            @if (Model.Count > 0)
                            {
                                @:Ingen ressurser passer søket eller filteret. Trykk «Nullstill filter» for å se alle.
                            }
                            else if (serAlle)
                            {
                                @:Ingen ressurser er tilbudt ennå.
                            }
                            else
                            {
                                @:Du har ikke tilbudt noen ressurser ennå. Trykk «Tilby ressurs» for å registrere den første.
                            }
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    @* kartikoner.js har funksjonen lagIkonSvg, som lager de samme ikonene som på kartet. *@
    <script src="~/js/kartikoner.js" asp-append-version="true"></script>
    @* sokefelt.js har søkefunksjonene tabellfilter.js bruker, så den må komme først. *@
    <script src="~/js/sokefelt.js" asp-append-version="true"></script>
    <script src="~/js/tabellfilter.js" asp-append-version="true"></script>
}

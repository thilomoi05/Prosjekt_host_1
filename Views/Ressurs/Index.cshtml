@model List<RessursRad>
@{
    // Offentlige aktører ser alle godkjente ressurser. Private aktører ser bare sine egne
    // (det sjekkes i RessursController.Index), så overskriften sier det samme.
    var serAlle = User.IsInRole(Roller.OffentligAktor);
    ViewData["Title"] = serAlle ? "Ressurser" : "Mine ressurser";

    // Valgene i filtermenyene lages ut fra ressursene som finnes, så nye typer kommer med av seg selv.
    var typer = Model
        .GroupBy(r => r.Ressurs.Type)
        .Select(g => (Verdi: g.Key.ToString(), Tekst: g.First().Ressurs.VisningsNavn))
        .OrderBy(t => t.Tekst)
        .ToList();

    // Status har faste valg, i den rekkefølgen som gir mening. Samme tekster som på Oversikt og detaljsiden.
    var statuser = new List<(string Verdi, string Tekst)>
    {
        ("Tilgjengelig", "Tilgjengelig"),
        ("Tildelt", "Tildelt et behov"),
        ("Venter", "Venter på godkjenning"),
        ("Avvist", "Avvist")
    };

    // "Meldt av": egne ressurser eller andres, som på Behov-siden. /Ressurs?meldtav=meg viser bare egne.
    var brukernavn = User.Identity?.Name ?? string.Empty;
    var meldtAvValg = new List<(string Verdi, string Tekst)> { ("meg", "Meg"), ("andre", "Andre") };
}

<div class="bp-side-innhold">
    <div class="bp-tabell-kort">
        <div class="bp-tabell-kort-hode">
            <div>
                <h2>@(serAlle ? "Alle ressurser" : "Mine ressurser")</h2>
                @* Teksten og "Nullstill filter" oppdateres av tabellfilter.js. *@
                <p class="bp-filter-status">
                    <span id="tabell-antall">Viser @Model.Count ressurser</span>
                    <button type="button" class="bp-filter-nullstill" id="tabell-nullstill" hidden>Nullstill filter</button>
                </p>
            </div>
            @* Samme knapp som "Registrer nytt behov" på Behov-siden. Dette er veien til skjemaet,
               siden "Tilby ressurs" ikke lenger er en egen fane i menyen. *@
            <a class="btn btn-bp-primær" asp-controller="Ressurs" asp-action="Registrer">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="bp-knapp-ikon" aria-hidden="true">
                    <line x1="12" y1="5" x2="12" y2="19" />
                    <line x1="5" y1="12" x2="19" y2="12" />
                </svg>
                Tilby ressurs
            </a>
        </div>

        <div class="table-responsive bp-tabell-med-filter">
            @* data-enhet er ordet i "Viser 8 av 12 ressurser" (tabellfilter.js). *@
            <table class="bp-tabell bp-tabell-ikoner" id="filtertabell" data-enhet="ressurser">
                <thead>
                    <tr>
                        @* Filteret heter "ressurstype", så valgene i menyen får firkant-ikonet (se _Filtermeny). *@
                        <th><partial name="_Filtermeny" model='("Type ressurs", "ressurstype", typer)' /></th>
                        <th>Adresse</th>
                        <th><partial name="_Filtermeny" model='("Status", "status", statuser)' /></th>
                        <th><partial name="_Filtermeny" model='("Meldt av", "meldtav", meldtAvValg)' /></th>
                        @* Sorterer på når ressursen er tilgjengelig fra. Uten fra-dato er den tilgjengelig nå. *@
                        <th><partial name="_Datosortering" model='"Tilgjengelig fra"' /></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rad in Model)
                    {
                        var ressurs = rad.Ressurs;
                        var erMin = ressurs.RegistrertAv == brukernavn;

                        // Status: venter på godkjenning, avvist, tildelt eller tilgjengelig (som på Oversikt).
                        var (status, cssKlasse, tekst) = ressurs.Status switch
                        {
                            RessursStatus.Venter => ("Venter", "bp-badge-godkjenning", "Venter på godkjenning"),
                            RessursStatus.Avvist => ("Avvist", "bp-badge-avvist", "Avvist"),
                            _ when rad.ErTildelt => ("Tildelt", "bp-badge-tildelt", "Tildelt et behov"),
                            _ => ("Tilgjengelig", "bp-badge-venter", "Tilgjengelig")
                        };
                        @* data-rad markerer raden for tabellfilter.js. De andre data-* er verdiene filteret og sorteringen bruker.
                           Ressurser uten fra-dato får "0000-00-00", så de regnes som eldst (tilgjengelig nå). *@
                        <tr data-rad
                            data-ressurstype="@ressurs.Type"
                            data-status="@status"
                            data-meldtav="@(erMin ? "meg" : "andre")"
                            data-dato="@(ressurs.TilgjengeligFra?.ToString("yyyy-MM-dd") ?? "0000-00-00")">
                            <td>
                                @* Samme firkant-ikon som på kartet. Fylles inn av tabellfilter.js.
                                   Navnet er en lenke til detaljsiden (Ressurs/Detaljer/id), som på Behov-siden. *@
                                <span class="bp-kartikon bp-ikon-ressurs" data-ikon-type="@ressurs.Type" data-ikon-form="ressurs"></span>
                                <a class="bp-oversikt-lenke" asp-controller="Ressurs" asp-action="Detaljer" asp-route-id="@ressurs.Id">@ressurs.VisningsNavn</a>
                            </td>
                            <td>@ressurs.Adresse</td>
                            <td><span class="bp-badge @cssKlasse">@tekst</span></td>
                            @* Samme som "Meldt av" på Behov-siden: brukernavnet, eller "Deg" for egne. *@
                            <td>@(erMin ? "Deg" : ressurs.RegistrertAv)</td>
                            @* Samme datoformat som "Dato" på Behov-siden. Tom fra-dato betyr at den er tilgjengelig nå. *@
                            <td>@(ressurs.TilgjengeligFra?.ToString("yyyy-MM-dd") ?? "Nå")</td>
                        </tr>
                    }
                    @* Vises av tabellfilter.js når ingen ressurser passer filteret. Finnes det ingen ressurser
                       i det hele tatt, står samme tekst som på Oversikt i stedet. *@
                    <tr id="tabell-tom" hidden>
                        <td colspan="5" class="bp-oversikt-tom">
                            @(Model.Count == 0
                                ? "Du har ikke tilbudt noen ressurser ennå. Trykk «Tilby ressurs» for å registrere den første."
                                : "Ingen ressurser passer filteret. Trykk «Nullstill filter» for å se alle.")
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    @* kartikoner.js har funksjonen lagIkonSvg, som lager de samme ikonene som på kartet. *@
    <script src="~/js/kartikoner.js" asp-append-version="true"></script>
    <script src="~/js/tabellfilter.js" asp-append-version="true"></script>
}

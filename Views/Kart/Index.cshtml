@{
    ViewData["Title"] = "Kart";

    // Satt i KartController.Index(): true hvis brukeren har lov til å se ressurser.
    var kanSeRessurser = (bool)(ViewData["KanSeRessurser"] ?? false);
}

@section Styles {
    <link rel="stylesheet" href="~/lib/leaflet/leaflet.css" />
}

@* Kartsiden bruker hele skjermen under menyen, fordi kartet er hovedfunksjonen.
   Listen over punktene ligger i et panel som åpnes med knappen nederst. *@
<div class="bp-kart-fullskjerm">
    @* Her tegner Leaflet kartet. data-kan-se-ressurser leses av kart.js. *@
    <div id="kart" class="bp-kart" data-kan-se-ressurser="@(kanSeRessurser ? "true" : "false")"></div>

    @* Filterpanelet til venstre. Fungerer også som tegnforklaring: hver type har
       samme ikon som på kartet. Innholdet (typer og antall) lages av kart.js ut fra
       punktene som er hentet, så nye typer kommer med av seg selv. *@
    @* Knappen øverst til venstre åpner filteret. Samme stil som "Vis liste".
       Teksten "(14 av 40)" legges til av kart.js når noe er filtrert bort. *@
    <button type="button" class="btn btn-bp-primær bp-filter-knapp" id="filter-apne"
            aria-controls="kart-filter" aria-expanded="false">
        @* Ikon: tre glidebrytere *@
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <line x1="3" y1="6" x2="21" y2="6" /><circle cx="9" cy="6" r="2.2" fill="currentColor" />
            <line x1="3" y1="12" x2="21" y2="12" /><circle cx="15" cy="12" r="2.2" fill="currentColor" />
            <line x1="3" y1="18" x2="21" y2="18" /><circle cx="8" cy="18" r="2.2" fill="currentColor" />
        </svg>
        Filter <span id="filter-knapp-status"></span>
    </button>

    @* Panelet er skjult når kartet åpnes (klassen "skjult"), og kommer frem når man trykker "Filter". *@
    <aside class="bp-filter skjult" id="kart-filter" aria-label="Filter for kartet">
        <div class="bp-filter-hode">
            <strong>Filter</strong>
            <button type="button" class="bp-filter-nullstill" id="filter-nullstill">Nullstill</button>
            <span class="bp-filter-treff">Treff (<span id="filter-treff">0</span>)</span>
            <button type="button" class="bp-filter-lukk" id="filter-lukk" aria-label="Lukk filteret">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <line x1="6" y1="6" x2="18" y2="18" /><line x1="18" y1="6" x2="6" y2="18" />
                </svg>
            </button>
        </div>
        <div class="bp-filter-innhold" id="filter-innhold">
            <p class="bp-filter-laster">Laster ...</p>
        </div>

    </aside>

    @* Knappen åpner listen nederst. Bootstrap ("offcanvas") åpner og lukker
       panelet, så vi trenger ingen egen JavaScript til det. *@
    <button type="button" class="btn btn-bp-primær bp-kart-listeknapp"
            data-bs-toggle="offcanvas" data-bs-target="#kart-liste-panel" aria-controls="kart-liste-panel">
        Vis liste
    </button>
</div>

@* Panelet som glir opp fra bunnen og dekker hele skjermen under menyen. Tabellen er de samme punktene som
   på kartet, og fungerer også for skjermlesere som ikke kan lese kartet. *@
<div class="offcanvas offcanvas-bottom bp-kart-liste-panel" id="kart-liste-panel"
     data-bs-backdrop="false" data-bs-scroll="true" tabindex="-1" aria-labelledby="kart-liste-tittel">
    <div class="offcanvas-header">
        <div>
            <h2 class="h5 mb-0" id="kart-liste-tittel">
                @* Teksten byttes til "Tilgjengelige ressurser" av kart.js når adressen er /Kart?liste=ressurser. *@
                <span id="kart-liste-tittel-tekst">Punkter på kartet</span>
            </h2>
            @* "Viser 9 av 40" og "Nullstill filter" oppdateres av kart.js (visTabell). *@
            <p class="bp-filter-status">
                <span id="kart-antall"></span>
                <button type="button" class="bp-filter-nullstill" id="liste-nullstill" hidden>Nullstill filter</button>
            </p>
        </div>
        @* Listen dekker hele skjermen. Knappen øverst i midten tar kartet frem igjen.
           data-bs-dismiss="offcanvas" gjør at Bootstrap lukker panelet. *@
        <button type="button" class="btn btn-bp-primær bp-kart-skjulknapp" data-bs-dismiss="offcanvas">
            Vis kart
        </button>
    </div>
    <div class="offcanvas-body">
        <table class="bp-tabell">
            @* Filtermenyene i overskriftene (Hva, Type, Prioritet, Status) lages av kart.js
               (byggListemenyer). De er koblet til filterpanelet, så kartet og listen viser det samme. *@
            <thead id="kart-liste-hode">
                <tr>
                    <th id="liste-kolonne-hva">Hva</th>
                    <th id="liste-kolonne-type">Type</th>
                    <th>Sted</th>
                    <th id="liste-kolonne-prioritet">Prioritet</th>
                    <th id="liste-kolonne-status">Status</th>
                    @* Kolonne for "Se detaljer"-lenken. Teksten er skjult, men leses av skjermlesere. *@
                    <th><span class="visually-hidden">Detaljer</span></th>
                </tr>
            </thead>
            @* Radene fylles inn av kart.js når dataene er hentet. *@
            <tbody id="kart-liste">
                <tr><td colspan="6" class="text-muted">Laster ...</td></tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/lib/leaflet/leaflet.js"></script>
    <script src="~/js/kartverket.js" asp-append-version="true"></script>
    <script src="~/js/kartikoner.js" asp-append-version="true"></script>
    <script src="~/js/kart.js" asp-append-version="true"></script>
}

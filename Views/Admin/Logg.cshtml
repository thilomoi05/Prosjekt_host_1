@model List<LoggRad>
@{
    ViewData["Title"] = "Logg";

    // De tre kategoriene i fast rekkefølge, med antall hendelser i hver.
    // Brukes både i forklaringen øverst og i kategorifilteret i tabellen.
    var kategorier = new[] { "Behov", "Ressurs", "Brukere" }
        .Select(k => (Navn: k, Antall: Model.Count(r => r.Kategori == k)))
        .ToList();

    var kategoriValg = kategorier
        .Where(k => k.Antall > 0)
        .Select(k => (Verdi: k.Navn, Tekst: k.Navn))
        .ToList();

    var brukere = Model
        .Select(r => r.Hendelse.UtfortAv)
        .Distinct()
        .OrderBy(b => b)
        .Select(b => (Verdi: b, Tekst: b))
        .ToList();
}

@* Adminloggen (AdminController.Logg): hva som har skjedd med behov, ressurser og brukere,
   når og av hvem. Bruker samme tabell, søk og filtre som Behov-siden (tabellfilter.js).
   Hver kategori har sin farge (se "Adminloggen" i site.css). *@
<div class="bp-side-innhold">
    <div class="bp-tabell-kort">
        <div class="bp-tabell-kort-hode">
            <div>
                <h2>Logg</h2>
                @* Teksten og "Nullstill filter" oppdateres av tabellfilter.js. *@
                <p class="bp-filter-status">
                    <span id="tabell-antall" aria-live="polite">Viser @Model.Count hendelser</span>
                    <button type="button" class="bp-filter-nullstill" id="tabell-nullstill" hidden>Nullstill filter</button>
                </p>
            </div>
            <a class="bp-tilbake" asp-controller="Admin" asp-action="Index">&larr; Til admin</a>
        </div>

        @* Forklaring på fargene. Hver lenke åpner loggen med bare den kategorien,
           f.eks. /Admin/Logg?kategori=Behov (tabellfilter.js leser filteret fra adressen). *@
        <nav class="bp-logg-forklaring" aria-label="Kategorier i loggen">
            @foreach (var (navn, antall) in kategorier)
            {
                var klasse = $"bp-logg-kategori bp-logg-{navn.ToLowerInvariant()}";
                if (antall > 0)
                {
                    <a class="@klasse" asp-action="Logg" asp-route-kategori="@navn">
                        <span class="bp-logg-prikk" aria-hidden="true"></span>
                        @navn
                        <span class="bp-logg-kategori-antall">@antall</span>
                    </a>
                }
                else
                {
                    @* Ingen hendelser i kategorien ennå: vises, men er ikke en lenke. *@
                    <span class="@klasse bp-logg-kategori-tom">
                        <span class="bp-logg-prikk" aria-hidden="true"></span>
                        @navn
                        <span class="bp-logg-kategori-antall">0</span>
                    </span>
                }
            }
        </nav>

        <partial name="_Sokefelt" model='("tabell-sok", "Søk i loggen")' />

        <div class="table-responsive bp-tabell-med-filter">
            @* data-enhet er ordet i "Viser 12 av 80 hendelser" (tabellfilter.js). *@
            <table class="bp-tabell bp-logg" id="filtertabell" data-enhet="hendelser">
                <thead>
                    <tr>
                        <th><partial name="_Datosortering" model='"Tidspunkt"' /></th>
                        <th><partial name="_Filtermeny" model='("Kategori", "kategori", kategoriValg)' /></th>
                        <th>Hendelse</th>
                        <th>Gjelder</th>
                        <th><partial name="_Filtermeny" model='("Utført av", "bruker", brukere)' /></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rad in Model)
                    {
                        var h = rad.Hendelse;
                        @* data-rad markerer raden for tabellfilter.js. De andre data-* er verdiene filtrene bruker.
                           data-dato har med sekunder, så hendelser i samme minutt sorteres riktig.
                           Fargeklassen gir streken til venstre og fargen på merket. *@
                        <tr data-rad
                            class="@rad.Fargeklasse"
                            data-kategori="@rad.Kategori"
                            data-bruker="@h.UtfortAv"
                            data-dato="@h.Tidspunkt.ToString("yyyy-MM-dd HH:mm:ss")">
                            <td class="bp-logg-tid">
                                <time datetime="@h.Tidspunkt.ToString("yyyy-MM-ddTHH:mm:ss")">@h.Tidspunkt.ToString("dd.MM.yyyy HH:mm")</time>
                            </td>
                            <td><span class="bp-badge bp-badge-logg">@rad.Kategori</span></td>
                            <td>@h.Beskrivelse</td>
                            <td>
                                @* Lenke til behovet eller ressursen. Er den trukket tilbake, gir lenken "Fant ikke siden",
                                   men historikken blir liggende (Hendelser har ingen fremmednøkler). *@
                                @if (h.BehovId is not null)
                                {
                                    <a class="bp-oversikt-lenke" asp-controller="Behov" asp-action="Detaljer" asp-route-id="@h.BehovId">Behov #@h.BehovId</a>
                                }
                                else if (h.RessursId is not null)
                                {
                                    <a class="bp-oversikt-lenke" asp-controller="Ressurs" asp-action="Detaljer" asp-route-id="@h.RessursId">Ressurs #@h.RessursId</a>
                                }
                                else
                                {
                                    <span class="bp-logg-tom">–</span>
                                }
                            </td>
                            <td>@h.UtfortAv</td>
                        </tr>
                    }
                    @* Vises av tabellfilter.js når ingen rader passer søket eller filteret. *@
                    <tr id="tabell-tom" hidden>
                        <td colspan="5" class="bp-oversikt-tom">Ingen hendelser passer søket eller filteret. Trykk «Nullstill filter» for å se alle.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    @* sokefelt.js har søkefunksjonene tabellfilter.js bruker, så den må komme først. *@
    <script src="~/js/sokefelt.js" asp-append-version="true"></script>
    <script src="~/js/tabellfilter.js" asp-append-version="true"></script>
}

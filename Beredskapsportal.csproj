<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>d315e3fc-939d-4e0a-b39c-699525c65d9a</UserSecretsId>
    <!-- Starter appen via dotnet.exe. Windows Smart App Control blokkerer ellers den usignerte Beredskapsportal.exe -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Beredskapsportal.Tests/**" />
    <Content Remove="Beredskapsportal.Tests/**" />
    <None Remove="Beredskapsportal.Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microting.EntityFrameworkCore.MySql" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>